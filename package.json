{
  "name": "neural-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Neural Atlas — static-first research publication platform (plan.md implementation)",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/verify-math.mjs && node scripts/audit-html.mjs",
    "verify:math": "node scripts/verify-math.mjs",
    "verify:html": "node scripts/audit-html.mjs",
    "images": "node scripts/optimize-images.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "content:validate": "node scripts/validate-content.mjs",
    "verify:determinism": "node scripts/verify-determinism.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "next": "^15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rehype-autolink-headings": "^7.1.0"
  },
  "devDependencies": {
    "@shikijs/rehype": "^1.29.2",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.19",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "sharp": "^0.34.5",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^1.29.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  }
}
